    <Item class="ModuleScript" referent="RBX3">
      <Properties>
        <string name="Name">Config</string>
        <ProtectedString name="Source">local Config = {}
Config.StartingCash = 900
Config.BaseHealth = 100
Config.MaxTroops = 12
Config.MaxWaves = 8
Config.SellRatio = 0.7
Config.DeployInterval = 0.6
Config.Units = {
    { name = "Ember Ronin", role = "MELEE / FRONT LINE", cost = 300, health = 240, speed = 13, damage = 22, range = 6, cooldown = 0.7, color = {255, 123, 79} },
    { name = "Frost Oracle", role = "RANGED / SLOW", cost = 400, health = 170, speed = 11, damage = 16, range = 19, cooldown = 1.2, slow = 0.5, color = {92, 217, 255} },
    { name = "Astral Warden", role = "RANGED / SPLASH", cost = 550, health = 210, speed = 10, damage = 45, range = 23, cooldown = 2.2, splash = 10, color = {186, 140, 255} },
}
function Config.stats(kind, level)
    local unit = Config.Units[kind]
    if not unit or not Config.validInteger(level, 1, 4) then return nil end
    return {
        damage = math.floor(unit.damage * (1 + (level - 1) * 0.65)),
        health = math.floor(unit.health * (1 + (level - 1) * 0.6)),
        range = unit.range,
        speed = unit.speed,
        cooldown = unit.cooldown,
        upgradeCost = level &lt; 4 and math.floor(unit.cost * (0.7 + level * 0.45)) or nil,
    }
end
function Config.invested(kind, level)
    local total = Config.Units[kind].cost
    for previous = 1, level - 1 do total = total + Config.stats(kind, previous).upgradeCost end
    return total
end
function Config.wave(index)
    return {
        count = 6 + index * 2,
        health = math.floor(45 * 1.32 ^ (index - 1)),
        speed = 9 + index * 0.6,
        damage = 6 + index * 1.5,
        cooldown = 1.1,
        reward = 22 + index * 3,
        clearReward = 100 + index * 35,
        boss = index == Config.MaxWaves,
    }
end
function Config.validInteger(value, minimum, maximum)
    return type(value) == "number" and value == value and value % 1 == 0 and value &gt;= minimum and value &lt;= maximum
end
return Config
</ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX4">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="RBX5">
      <Properties>
        <string name="Name">GameServer</string>
        <ProtectedString name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local Config = require(ReplicatedStorage:WaitForChild("Config"))

local api = Instance.new("Folder")
api.Name = "MysteriousAPI"
api.Parent = ReplicatedStorage
local action = Instance.new("RemoteEvent", api)
action.Name = "Action"
local stateEvent = Instance.new("RemoteEvent", api)
stateEvent.Name = "State"
local fxEvent = Instance.new("RemoteEvent", api)
fxEvent.Name = "FX"

local world = Instance.new("Folder", workspace)
world.Name = "MysteriousWorld"
local troopsFolder = Instance.new("Folder", world)
troopsFolder.Name = "Troops"
local enemiesFolder = Instance.new("Folder", world)
enemiesFolder.Name = "Enemies"
local path = {
    Vector3.new(-72, 1, -42), Vector3.new(-38, 1, -42), Vector3.new(-38, 1, 8),
    Vector3.new(0, 1, 8), Vector3.new(0, 1, -30), Vector3.new(38, 1, -30),
    Vector3.new(38, 1, 35), Vector3.new(72, 1, 35),
}
local troops = {}
local enemies = {}
local wallets = {}
local lastRequests = {}
local replayVotes = {}
local match = {wave = 0, health = Config.BaseHealth, phase = "BUILD", speed = 1, countdown = 0}
local nextTroopID, nextEnemyID = 0, 0
local spawnRemaining, spawnClock, intermission = 0, 0, 0
local syncClock = 0

local function part(name, size, position, color, parent, material)
    local p = Instance.new("Part")
    p.Name = name
    p.Size = size
    p.Position = position
    p.Color = color
    p.Anchored = true
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    p.Material = material or Enum.Material.SmoothPlastic
    p.Parent = parent or world
    return p
end
local function label(adornee, text, color, height)
    local gui = Instance.new("BillboardGui", adornee)
    gui.Size = UDim2.fromOffset(170, 42)
    gui.StudsOffset = Vector3.new(0, height or 4, 0)
    gui.AlwaysOnTop = true
    gui.MaxDistance = 180
    local textLabel = Instance.new("TextLabel", gui)
    textLabel.Size = UDim2.fromScale(1, 1)
    textLabel.BackgroundTransparency = 1
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextSize = 13
    textLabel.TextColor3 = color or Color3.new(1, 1, 1)
    textLabel.TextStrokeTransparency = 0.4
    textLabel.Text = text
    return textLabel
end

Lighting.ClockTime = 17.5
Lighting.Brightness = 2
Lighting.Ambient = Color3.fromRGB(120, 130, 160)
part("Valley", Vector3.new(174, 2, 116), Vector3.new(0, -1, 0), Color3.fromRGB(40, 66, 64), world, Enum.Material.Grass)
for i = 1, #path - 1 do
    local a, b = path[i], path[i + 1]
    local lane = part("EnemyPath", Vector3.new(10, 0.3, (b - a).Magnitude + 9), (a + b) / 2, Color3.fromRGB(122, 112, 99), world, Enum.Material.Cobblestone)
    lane.CFrame = CFrame.lookAt((a + b) / 2, b)
end
local portal = part("RiftPortal", Vector3.new(2, 15, 14), path[1] + Vector3.new(-3, 6, 0), Color3.fromRGB(177, 90, 255), world, Enum.Material.Neon)
portal.CanCollide = false
label(portal, "THE RIFT / ENEMY SPAWN", Color3.fromRGB(221, 193, 255), 9)
local core = part("ShrineCore", Vector3.new(7, 12, 7), path[#path] + Vector3.new(0, 5, 0), Color3.fromRGB(91, 239, 208), world, Enum.Material.Neon)
core:SetAttribute("PlayerBase", true)
label(core, "YOUR BASE / TROOPS DEPLOY HERE", Color3.fromRGB(159, 255, 229), 9)
local spawn = Instance.new("SpawnLocation", world)
spawn.Name = "PlayerSpawn"
spawn.Size = Vector3.new(8, 1, 8)
spawn.Position = Vector3.new(0, 2, 43)
spawn.Anchored = true
spawn.Neutral = true
spawn.Transparency = 1
spawn.Duration = 0
-- Original, asset-free lantern village: the entire map works offline.
for _, x in ipairs({-72, -20, 20, 70}) do
    for _, z in ipairs({-53, 53}) do
        local building = part("VillageHouse", Vector3.new(16, 11, 10), Vector3.new(x, 5, z), Color3.fromRGB(205, 186, 151))
        part("Roof", Vector3.new(20, 2, 14), building.Position + Vector3.new(0, 6, 0), Color3.fromRGB(44, 52, 76))
        part("Door", Vector3.new(4, 7, 0.3), building.Position + Vector3.new(0, -1, z &gt; 0 and -5.2 or 5.2), Color3.fromRGB(77, 54, 48))
    end
end
for _, xy in ipairs({{-62,18}, {-20,38}, {18,40}, {62,-18}}) do
    part("LanternPost", Vector3.new(1, 7, 1), Vector3.new(xy[1], 3, xy[2]), Color3.fromRGB(73, 58, 51))
    local lantern = part("Lantern", Vector3.new(2.5, 3, 2.5), Vector3.new(xy[1], 7, xy[2]), Color3.fromRGB(255, 199, 112), world, Enum.Material.Neon)
    local light = Instance.new("PointLight", lantern)
    light.Color = lantern.Color
    light.Range = 18
    light.Brightness = 1
end

-- Both armies use the same scalar route in opposite directions. This prevents
-- units from cutting across bends or walking through an opposing melee line.
local lengths, routeLength = {}, 0
for i = 1, #path - 1 do
    lengths[i] = (path[i + 1] - path[i]).Magnitude
    routeLength = routeLength + lengths[i]
end
local function pointAt(distance)
    local remaining = math.max(0, math.min(routeLength, distance))
    for i, length in ipairs(lengths) do
        if remaining &lt;= length then return path[i]:Lerp(path[i + 1], remaining / length) end
        remaining = remaining - length
    end
    return path[#path]
end
local function tell(player, message) stateEvent:FireClient(player, {notice = message}) end
local function troopCount(owner)
    local n = 0
    for _, t in pairs(troops) do if t.owner == owner then n = n + 1 end end
    return n
end
local function snapshot(player)
    local list, alive, allies, votes = {}, 0, 0, 0
    for id, t in pairs(troops) do
        list[#list + 1] = {id = id, kind = t.kind, level = t.level, owner = t.owner,
            hp = t.hp, maxHp = Config.stats(t.kind, t.level).health, status = t.status, distance = t.distance}
        if t.hp &gt; 0 then allies = allies + 1 end
    end
    table.sort(list, function(a, b) return a.id &lt; b.id end)
    for _ in pairs(enemies) do alive = alive + 1 end
    for _ in pairs(replayVotes) do votes = votes + 1 end
    return {wave = match.wave, health = match.health, phase = match.phase, speed = match.speed,
        cash = wallets[player.UserId] or Config.StartingCash, troops = list, alive = alive, allies = allies,
        countdown = math.ceil(match.countdown), votes = votes, players = #Players:GetPlayers(), routeLength = routeLength}
end
local function broadcast()
    for _, player in ipairs(Players:GetPlayers()) do stateEvent:FireClient(player, snapshot(player)) end
end
local function payout(amount)
    for id, cash in pairs(wallets) do wallets[id] = cash + amount end
end
local function removeEnemy(id)
    local e = enemies[id]
    if e then e.model:Destroy(); enemies[id] = nil end
end
-- Original block characters have heads, arms, legs and spirit weapons.
-- Anchored parts are posed by the server; no external rigs/assets are required.
local function character(name, color, parent, scale)
    local model = Instance.new("Model", parent)
    model.Name = name
    local parts = {}
    local function limb(key, size, offset, tint, material)
        local p = part(key, size * scale, Vector3.new(0, -100, 0), tint, model, material)
        p.CanCollide = false
        parts[key] = {part = p, offset = offset * scale}
        return p
    end
    local skin = Color3.fromRGB(242, 216, 189)
    local body = limb("Body", Vector3.new(2.4, 2.8, 1.3), Vector3.new(0, 3.4, 0), color)
    local head = limb("Head", Vector3.new(1.7, 1.7, 1.7), Vector3.new(0, 5.65, 0), skin)
    limb("Hair", Vector3.new(1.9, 0.65, 1.9), Vector3.new(0, 6.5, 0), color, Enum.Material.Neon)
    limb("LeftArm", Vector3.new(0.8, 2.6, 0.9), Vector3.new(-1.7, 3.4, 0), color)
    limb("RightArm", Vector3.new(0.8, 2.6, 0.9), Vector3.new(1.7, 3.4, 0), color)
    limb("LeftLeg", Vector3.new(1, 2, 1), Vector3.new(-0.65, 1, 0), Color3.fromRGB(36, 42, 65))
    limb("RightLeg", Vector3.new(1, 2, 1), Vector3.new(0.65, 1, 0), Color3.fromRGB(36, 42, 65))
    limb("SpiritBlade", Vector3.new(0.25, 3.8, 0.5), Vector3.new(2.2, 3.8, -0.8), color, Enum.Material.Neon)
    model.PrimaryPart = body
    return {model = model, body = body, parts = parts, text = label(head, name, color, 2.6 * scale), scale = scale, gait = 0}
end
local function pose(actor, position, direction, walking, attacking, dt)
    actor.gait = actor.gait + (walking and dt * 9 or 0)
    local swing = walking and math.sin(actor.gait) * 0.65 or 0
    local frame = CFrame.lookAt(position, position + direction)
    for key, limb in pairs(actor.parts) do
        local angle = 0
        if key == "LeftLeg" or key == "RightArm" then angle = swing end
        if key == "RightLeg" or key == "LeftArm" then angle = -swing end
        if attacking and (key == "RightArm" or key == "SpiritBlade") then angle = -1.1 end
        limb.part.CFrame = frame * CFrame.new(limb.offset) * CFrame.Angles(angle, 0, 0)
    end
end
local function updateTroopLabel(t)
    t.text.Text = Config.Units[t.kind].name .. " / Lv." .. t.level .. "\n" .. math.ceil(t.hp) .. " HP / " .. t.status
end
local function resetTroop(t, delay)
    t.hp = Config.stats(t.kind, t.level).health
    t.distance, t.cooldown, t.releaseDelay = routeLength, 0, delay or 0
    t.status = match.phase == "WAVE" and "DEPLOYING" or "READY"
    t.model.Parent = troopsFolder
    pose(t, pointAt(routeLength) + Vector3.new((t.id % 3 - 1) * 2.5, 0, 5 + (t.id % 4) * 2), Vector3.new(-1, 0, 0), false, false, 0)
    updateTroopLabel(t)
end
local function clearBattle()
    for id in pairs(enemies) do removeEnemy(id) end
    for id, t in pairs(troops) do t.model:Destroy(); troops[id] = nil end
    for id in pairs(wallets) do wallets[id] = Config.StartingCash end
    match = {wave = 0, health = Config.BaseHealth, phase = "BUILD", speed = 1, countdown = 0}
    spawnRemaining, intermission = 0, 0
    replayVotes = {}
end
local function startWave()
    match.wave = match.wave + 1
    match.phase, match.countdown = "WAVE", 0
    spawnRemaining, spawnClock = Config.wave(match.wave).count, 0
    local ids = {}
    for id in pairs(troops) do ids[#ids + 1] = id end
    table.sort(ids)
    for index, id in ipairs(ids) do resetTroop(troops[id], (index - 1) * Config.DeployInterval) end
    broadcast()
end
local function spawnEnemy()
    local settings = Config.wave(match.wave)
    local boss = settings.boss and spawnRemaining == 1
    local runner = not boss and spawnRemaining % 4 == 0
    nextEnemyID = nextEnemyID + 1
    local name = boss and "Rift Sovereign" or runner and "Rift Runner" or "Rift Shade"
    local c = boss and Color3.fromRGB(248, 73, 136) or runner and Color3.fromRGB(255, 176, 91) or Color3.fromRGB(141, 103, 182)
    local e = character(name, c, enemiesFolder, boss and 1.7 or 0.85)
    e.hp = math.floor(settings.health * (boss and 10 or runner and 0.65 or 1))
    e.maxHp, e.distance, e.cooldown = e.hp, 0, 0
    e.speed = settings.speed * (boss and 0.65 or runner and 1.7 or 1)
    e.damage = settings.damage * (boss and 2.5 or 1)
    e.interval, e.range = settings.cooldown, boss and 8 or 5
    e.reward, e.leak, e.slowUntil = settings.reward * (boss and 8 or 1), boss and 30 or 8, 0
    e.name, e.boss = name, boss
    e.text.Text = name .. "\n" .. e.hp .. " HP"
    pose(e, pointAt(0), Vector3.new(1, 0, 0), false, false, 0)
    enemies[nextEnemyID] = e
end
local function damageEnemy(id, damage, slow)
    local e = enemies[id]
    if not e then return end
    e.hp = math.max(0, e.hp - damage)
    if slow then e.slowUntil = 1.8 end
    if e.hp &lt;= 0 then payout(e.reward); removeEnemy(id)
    else e.text.Text = e.name .. "\n" .. math.ceil(e.hp) .. " / " .. e.maxHp end
end
local function damageTroop(t, damage)
    t.hp = math.max(0, t.hp - damage)
    if t.hp == 0 then
        t.status = "DOWN"
        -- Keep the recruited squad slot and investment. Revive at the next wave.
        t.model.Parent = nil
    end
    updateTroopLabel(t)
end
local function recruit(player, kind)
    nextTroopID = nextTroopID + 1
    local unit = Config.Units[kind]
    local t = character(unit.name, Color3.fromRGB(unit.color[1], unit.color[2], unit.color[3]), troopsFolder, 1)
    t.id, t.kind, t.owner, t.level = nextTroopID, kind, player.UserId, 1
    t.model.Name = "Troop_" .. t.id
    t.model:SetAttribute("TroopID", t.id)
    troops[t.id] = t
    resetTroop(t, 0)
end
local function firstOpponent(distance, opponents, isTroop)
    local targetID, gap = nil, math.huge
    for id, other in pairs(opponents) do
        if other.hp &gt; 0 and (not isTroop or (other.status ~= "DEPLOYING" and other.status ~= "READY")) then
            local separation = math.abs(distance - other.distance)
            if separation &lt; gap or (separation == gap and (not targetID or id &lt; targetID)) then targetID, gap = id, separation end
        end
    end
    return targetID, gap
end
local function updateTroops(dt)
    -- Use stable order so a front line can take pressure before support troops.
    local ids = {}
    for id in pairs(troops) do ids[#ids + 1] = id end
    table.sort(ids)
    for _, id in ipairs(ids) do
        local t = troops[id]
        if t.hp &gt; 0 then
            t.releaseDelay = math.max(0, t.releaseDelay - dt)
            if t.releaseDelay &lt;= 0 then
                local stats = Config.stats(t.kind, t.level)
                local targetID, gap = firstOpponent(t.distance, enemies, false)
                t.cooldown = math.max(0, t.cooldown - dt)
                local walking = not targetID or gap &gt; stats.range
                if walking then
                    local travel = stats.speed * dt
                    if targetID then travel = math.min(travel, math.max(0, gap - stats.range)) end
                    t.distance = math.max(0, t.distance - travel)
                    t.status = t.distance == 0 and "AT_RIFT" or "MARCHING"
                else
                    t.status = "FIGHTING"
                    if t.cooldown &lt;= 0 then
                        local enemy = enemies[targetID]
                        local unit = Config.Units[t.kind]
                        fxEvent:FireAllClients(t.body.Position, enemy.body.Position, t.kind)
                        if unit.splash then
                            local hits = {}
                            for enemyID, e in pairs(enemies) do
                                if math.abs(e.distance - enemy.distance) &lt;= unit.splash then hits[#hits + 1] = enemyID end
                            end
                            for _, enemyID in ipairs(hits) do damageEnemy(enemyID, stats.damage) end
                        else damageEnemy(targetID, stats.damage, unit.slow) end
                        t.cooldown = stats.cooldown
                    end
                end
                local position = pointAt(t.distance)
                local destination = pointAt(math.max(0, t.distance - 1))
                if targetID and enemies[targetID] then destination = pointAt(enemies[targetID].distance) end
                local direction = destination - position
                if direction.Magnitude &lt; 0.01 then direction = Vector3.new(-1, 0, 0) end
                pose(t, position + Vector3.new((t.id % 3 - 1) * 1.5, 0, 0), direction, walking and t.distance &gt; 0, not walking, dt)
                updateTroopLabel(t)
            end
        end
    end
end
local function updateEnemies(dt)
    for id, e in pairs(enemies) do
        e.slowUntil = math.max(0, e.slowUntil - dt)
        e.cooldown = math.max(0, e.cooldown - dt)
        local targetID, gap = firstOpponent(e.distance, troops, true)
        local walking = not targetID or gap &gt; e.range
        if walking then
            local travel = e.speed * (e.slowUntil &gt; 0 and 0.5 or 1) * dt
            if targetID then travel = math.min(travel, math.max(0, gap - e.range)) end
            e.distance = math.min(routeLength, e.distance + travel)
        elseif e.cooldown &lt;= 0 then
            local t = troops[targetID]
            fxEvent:FireAllClients(e.body.Position, t.body.Position, 0)
            damageTroop(t, e.damage)
            e.cooldown = e.interval
        end
        local position = pointAt(e.distance)
        local destination = pointAt(math.min(routeLength, e.distance + 1))
        if targetID and troops[targetID] and troops[targetID].hp &gt; 0 then destination = pointAt(troops[targetID].distance) end
        local direction = destination - position
        if direction.Magnitude &lt; 0.01 then direction = Vector3.new(1, 0, 0) end
        pose(e, position, direction, walking, not walking, dt)
        if e.distance &gt;= routeLength then match.health = math.max(0, match.health - e.leak); removeEnemy(id) end
    end
end
local function checkReplay(excludedUserID)
    if match.phase ~= "VICTORY" and match.phase ~= "DEFEAT" then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.UserId ~= excludedUserID and not replayVotes[p.UserId] then return end
    end
    clearBattle()
end
Players.PlayerAdded:Connect(function(player) wallets[player.UserId] = Config.StartingCash end)
Players.PlayerRemoving:Connect(function(player)
    wallets[player.UserId], lastRequests[player.UserId], replayVotes[player.UserId] = nil, nil, nil
    for id, t in pairs(troops) do
        if t.owner == player.UserId then t.model:Destroy(); troops[id] = nil end
    end
    local remaining = 0
    for _, p in ipairs(Players:GetPlayers()) do if p ~= player then remaining = remaining + 1 end end
    if remaining == 0 then clearBattle() else checkReplay(player.UserId) end
    broadcast()
end)
for _, player in ipairs(Players:GetPlayers()) do wallets[player.UserId] = Config.StartingCash end

action.OnServerEvent:Connect(function(player, command, arg)
    local now = os.clock()
    if now - (lastRequests[player.UserId] or -1) &lt; 0.12 then return end
    lastRequests[player.UserId] = now
    if command == "Sync" then stateEvent:FireClient(player, snapshot(player)); return end
    if command == "Restart" then
        if match.phase ~= "VICTORY" and match.phase ~= "DEFEAT" then return end
        replayVotes[player.UserId] = true
        checkReplay(); broadcast(); return
    end
    if match.phase == "VICTORY" or match.phase == "DEFEAT" then return end
    if command == "Start" then
        if match.phase == "BUILD" or match.phase == "BREAK" then startWave() end
    elseif command == "Speed" then
        if Players:GetPlayers()[1] ~= player then tell(player, "Only the host controls match speed."); return end
        match.speed = match.speed == 1 and 2 or 1
    elseif command == "Recruit" then
        if not Config.validInteger(arg, 1, #Config.Units) then return end
        if troopCount(player.UserId) &gt;= Config.MaxTroops then tell(player, "Squad limit reached (12)."); return end
        if wallets[player.UserId] &lt; Config.Units[arg].cost then tell(player, "Not enough credits."); return end
        wallets[player.UserId] = wallets[player.UserId] - Config.Units[arg].cost
        recruit(player, arg)
    elseif command == "Upgrade" or command == "Sell" then
        if not Config.validInteger(arg, 1, nextTroopID) then return end
        local t = troops[arg]
        if not t or t.owner ~= player.UserId then tell(player, "Select one of your own characters."); return end
        if command == "Upgrade" then
            local before = Config.stats(t.kind, t.level)
            local cost = before.upgradeCost
            if not cost then tell(player, "Maximum level reached."); return end
            if wallets[player.UserId] &lt; cost then tell(player, "Not enough credits."); return end
            wallets[player.UserId], t.level = wallets[player.UserId] - cost, t.level + 1
            if t.hp &gt; 0 then t.hp = t.hp + Config.stats(t.kind, t.level).health - before.health end
            updateTroopLabel(t)
        else
            wallets[player.UserId] = wallets[player.UserId] + math.floor(Config.invested(t.kind, t.level) * Config.SellRatio)
            t.model:Destroy(); troops[arg] = nil
        end
    else return end
    broadcast()
end)

RunService.Heartbeat:Connect(function(delta)
    local dt = math.min(delta, 0.15) * match.speed
    if match.phase == "BREAK" then
        intermission = intermission - dt
        match.countdown = math.max(0, intermission)
        if intermission &lt;= 0 then startWave() end
    elseif match.phase == "WAVE" then
        spawnClock = spawnClock - dt
        if spawnRemaining &gt; 0 and spawnClock &lt;= 0 then
            spawnEnemy(); spawnRemaining = spawnRemaining - 1; spawnClock = 0.9
        end
        updateTroops(dt)
        updateEnemies(dt)
        if match.health &lt;= 0 then
            match.phase = "DEFEAT"
            for id in pairs(enemies) do removeEnemy(id) end
            spawnRemaining = 0
            broadcast(); return
        end
        if spawnRemaining == 0 and next(enemies) == nil then
            payout(Config.wave(match.wave).clearReward)
            if match.wave == Config.MaxWaves then match.phase = "VICTORY"
            else match.phase = "BREAK"; intermission = 12; match.countdown = 12 end
            broadcast()
        end
    end
    syncClock = syncClock + delta
    if syncClock &gt;= 0.4 then syncClock = 0; broadcast() end
end)
</ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX6">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CharacterWalkSpeed">0</float>
      <float name="CharacterJumpPower">0</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX7">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="RBX8">
        <Properties>
          <string name="Name">GameClient</string>
          <ProtectedString name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local player = Players.LocalPlayer
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local api = ReplicatedStorage:WaitForChild("MysteriousAPI")
local action, stateEvent, fxEvent = api:WaitForChild("Action"), api:WaitForChild("State"), api:WaitForChild("FX")
local world = workspace:WaitForChild("MysteriousWorld")
local troopsFolder = world:WaitForChild("Troops")
local selectedKind, selectedTroop = nil, nil
local pendingSelect = false
local latest, effects = nil, true
local noticeVersion = 0
local background = Color3.fromRGB(15, 22, 37)
local muted = Color3.fromRGB(160, 176, 198)
local accent = Color3.fromRGB(102, 238, 201)

local gui = Instance.new("ScreenGui")
gui.Name = "AnimeMysterious"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")
local root = Instance.new("Frame", gui)
root.BackgroundTransparency = 1
root.Size = UDim2.fromScale(1, 1)

local function rounded(obj, radius)
    local corner = Instance.new("UICorner", obj)
    corner.CornerRadius = UDim.new(0, radius or 12)
end
local function panel(parent, size, position)
    local frame = Instance.new("Frame", parent)
    frame.Size = size
    frame.Position = position
    frame.BackgroundColor3 = background
    frame.BackgroundTransparency = 0.06
    frame.BorderSizePixel = 0
    rounded(frame)
    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = Color3.fromRGB(66, 87, 110)
    stroke.Transparency = 0.35
    return frame
end
local function text(parent, value, size, pos, color, fontSize)
    local item = Instance.new("TextLabel", parent)
    item.Size = size
    item.Position = pos
    item.BackgroundTransparency = 1
    item.Text = value
    item.Font = Enum.Font.GothamMedium
    item.TextSize = fontSize or 15
    item.TextColor3 = color or Color3.new(1, 1, 1)
    item.TextXAlignment = Enum.TextXAlignment.Left
    item.TextWrapped = true
    return item
end
local function button(parent, value, size, pos, callback, color)
    local item = Instance.new("TextButton", parent)
    item.Size = size
    item.Position = pos
    item.Text = value
    item.TextColor3 = background
    item.Font = Enum.Font.GothamBold
    item.TextSize = 15
    item.BackgroundColor3 = color or accent
    item.BorderSizePixel = 0
    rounded(item, 8)
    item.Activated:Connect(callback)
    return item
end
local header = panel(root, UDim2.fromOffset(670, 78), UDim2.new(0.5, 0, 0, 10))
header.AnchorPoint = Vector2.new(0.5, 0)
local headerScale = Instance.new("UIScale", header)
text(header, "ANIME / MYSTERIOUS", UDim2.fromOffset(220, 24), UDim2.fromOffset(18, 9), accent, 16)
local waveText = text(header, "LANTERN VALLEY  /  WAVE 0 OF 8", UDim2.fromOffset(370, 22), UDim2.fromOffset(18, 40), muted, 13)
local healthText = text(header, "SHRINE  100 / 100", UDim2.fromOffset(200, 24), UDim2.fromOffset(440, 9), nil, 15)
local healthTrack = panel(header, UDim2.fromOffset(200, 8), UDim2.fromOffset(440, 44))
local healthFill = Instance.new("Frame", healthTrack)
healthFill.Size = UDim2.fromScale(1, 1)
healthFill.BackgroundColor3 = accent
healthFill.BorderSizePixel = 0
rounded(healthFill, 4)

local controls = panel(root, UDim2.fromOffset(220, 160), UDim2.new(1, -16, 0, 112))
controls.AnchorPoint = Vector2.new(1, 0)
local controlsScale = Instance.new("UIScale", controls)
local phaseText = text(controls, "ASSEMBLE YOUR SQUAD", UDim2.fromOffset(196, 25), UDim2.fromOffset(12, 9), accent, 13)
local aliveText = text(controls, "0 enemies alive", UDim2.fromOffset(196, 24), UDim2.fromOffset(12, 34), muted, 13)
local startButton = button(controls, "START WAVE  [SPACE]", UDim2.fromOffset(196, 36), UDim2.fromOffset(12, 66), function()
    action:FireServer(latest and (latest.phase == "VICTORY" or latest.phase == "DEFEAT") and "Restart" or "Start")
end)
local speedButton = button(controls, "SPEED  x1", UDim2.fromOffset(94, 32), UDim2.fromOffset(12, 113), function() action:FireServer("Speed") end, Color3.fromRGB(188, 205, 229))
local fxButton = button(controls, "FX  ON", UDim2.fromOffset(94, 32), UDim2.fromOffset(114, 113), function()
    effects = not effects
end, Color3.fromRGB(188, 205, 229))

local detail = panel(root, UDim2.fromOffset(258, 310), UDim2.new(0, 16, 0, 112))
local detailScale = Instance.new("UIScale", detail)
local detailTitle = text(detail, "YOUR MARCHING SQUAD", UDim2.fromOffset(230, 26), UDim2.fromOffset(14, 10), accent, 15)
local squadText = text(detail, "NO CHARACTERS YET", UDim2.fromOffset(140, 30), UDim2.fromOffset(14, 42), muted, 12)
local detailBody = text(detail, "", UDim2.fromOffset(230, 160), UDim2.fromOffset(14, 82), muted, 14)
local function cycleSquad(direction)
    if not latest then return end
    local own = {}
    local index = 0
    for _, t in ipairs(latest.troops) do
        if t.owner == player.UserId then
            own[#own + 1] = t
            if t.id == selectedTroop then index = #own end
        end
    end
    if #own &gt; 0 then
        index = ((index - 1 + direction) % #own) + 1
        selectedTroop, selectedKind = own[index].id, nil
    end
end
button(detail, "&lt;", UDim2.fromOffset(34, 30), UDim2.fromOffset(164, 42), function() cycleSquad(-1) end)
button(detail, "&gt;", UDim2.fromOffset(34, 30), UDim2.fromOffset(208, 42), function() cycleSquad(1) end)
local upgradeButton = button(detail, "UPGRADE", UDim2.fromOffset(144, 34), UDim2.fromOffset(12, 262), function()
    if selectedTroop then action:FireServer("Upgrade", selectedTroop) end
end)
local sellButton = button(detail, "SELL", UDim2.fromOffset(80, 34), UDim2.fromOffset(166, 262), function()
    if selectedTroop then action:FireServer("Sell", selectedTroop) end
end, Color3.fromRGB(255, 155, 144))
upgradeButton.Visible, sellButton.Visible = false, false

local dock = panel(root, UDim2.fromOffset(690, 132), UDim2.new(0.5, 0, 1, -14))
dock.AnchorPoint = Vector2.new(0.5, 1)
local dockScale = Instance.new("UIScale", dock)
local cashText = text(dock, "900 CREDITS", UDim2.fromOffset(330, 28), UDim2.fromOffset(14, 5), accent, 18)
local capText = text(dock, "0 / 12 UNITS", UDim2.fromOffset(170, 28), UDim2.fromOffset(513, 5), muted, 13)
local cards = {}
for kind, unit in ipairs(Config.Units) do
    local color = Color3.fromRGB(unit.color[1], unit.color[2], unit.color[3])
    local b = button(dock, "", UDim2.fromOffset(214, 80), UDim2.fromOffset(14 + (kind - 1) * 224, 39), function()
        selectedKind, pendingSelect = kind, true
        action:FireServer("Recruit", kind)
    end, Color3.fromRGB(35, 46, 65))
    text(b, kind .. "  " .. unit.name, UDim2.fromOffset(194, 24), UDim2.fromOffset(10, 5), color, 15)
    text(b, unit.role, UDim2.fromOffset(194, 18), UDim2.fromOffset(10, 30), muted, 10)
    local price = text(b, "RECRUIT  " .. unit.cost, UDim2.fromOffset(194, 22), UDim2.fromOffset(10, 51), nil, 14)
    local stroke = Instance.new("UIStroke", b)
    stroke.Color = color
    stroke.Thickness = 2
    cards[kind] = {button = b, stroke = stroke, price = price}
end
local notice = text(root, "Recruit a character below. Your squad marches from the base each wave.", UDim2.fromOffset(680, 42), UDim2.new(0.5, 0, 1, -159), Color3.new(1, 1, 1), 15)
notice.AnchorPoint = Vector2.new(0.5, 1)
notice.TextXAlignment = Enum.TextXAlignment.Center
notice.TextStrokeTransparency = 0.3
local noticeScale = Instance.new("UIScale", notice)
local function notify(message)
    noticeVersion = noticeVersion + 1
    local version = noticeVersion
    notice.Text = message
    task.delay(4, function()
        if version == noticeVersion then notice.Text = "Recruit a character below. Your squad marches from the base each wave." end
    end)
end

local rangePart = Instance.new("Part")
rangePart.Name = "LocalRangeIndicator"
rangePart.Shape = Enum.PartType.Cylinder
rangePart.Anchored = true
rangePart.CanCollide, rangePart.CanTouch, rangePart.CanQuery = false, false, false
rangePart.Material = Enum.Material.Neon
rangePart.Transparency = 0.9
rangePart.Color = accent
local function troopInfo(id)
    if latest then for _, t in ipairs(latest.troops) do if t.id == id then return t end end end
    return nil
end
local function showRange(position, radius, color)
    rangePart.Size = Vector3.new(0.1, radius * 2, radius * 2)
    rangePart.CFrame = CFrame.new(position.X, 1.55, position.Z) * CFrame.Angles(0, 0, math.pi / 2)
    rangePart.Color = color
    rangePart.Parent = workspace
end
local function hitAt(position)
    local camera = workspace.CurrentCamera
    local ray = camera:ScreenPointToRay(position.X, position.Y)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Include
    params.FilterDescendantsInstances = {troopsFolder}
    return workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
end
local function clicked(position)
    local result = hitAt(position)
    if not result then return end
    local model = result.Instance:FindFirstAncestorOfClass("Model")
    if model and model:GetAttribute("TroopID") then
        selectedTroop, selectedKind = model:GetAttribute("TroopID"), nil
    end
end
local function recruit(kind)
    selectedKind, pendingSelect = kind, true
    action:FireServer("Recruit", kind)
end
local touchStart = nil
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.UserInputType == Enum.UserInputType.Touch then touchStart = input.Position end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then clicked(input.Position) end
    if input.KeyCode == Enum.KeyCode.One then recruit(1)
    elseif input.KeyCode == Enum.KeyCode.Two then recruit(2)
    elseif input.KeyCode == Enum.KeyCode.Three then recruit(3)
    elseif input.KeyCode == Enum.KeyCode.Q then selectedKind, selectedTroop, pendingSelect = nil, nil, false
    elseif input.KeyCode == Enum.KeyCode.E and selectedTroop then action:FireServer("Upgrade", selectedTroop)
    elseif input.KeyCode == Enum.KeyCode.X and selectedTroop then action:FireServer("Sell", selectedTroop)
    elseif input.KeyCode == Enum.KeyCode.Space then action:FireServer("Start") end
end)
UserInputService.InputEnded:Connect(function(input, processed)
    if input.UserInputType == Enum.UserInputType.Touch then
        if not processed and touchStart and (input.Position - touchStart).Magnitude &lt; 20 then clicked(input.Position) end
        touchStart = nil
    end
end)
stateEvent.OnClientEvent:Connect(function(state)
    if state.notice then notify(state.notice); return end
    latest = state
    if pendingSelect then
        for i = #latest.troops, 1, -1 do
            local t = latest.troops[i]
            if t.owner == player.UserId and t.kind == selectedKind then selectedTroop = t.id; break end
        end
        pendingSelect = false
    end
    if selectedTroop and not troopInfo(selectedTroop) then selectedTroop = nil end
end)
fxEvent.OnClientEvent:Connect(function(origin, target, kind)
    if not effects then return end
    local unit = Config.Units[kind]
    local beam = Instance.new("Part")
    beam.Name = "LocalShot"
    beam.Anchored = true
    beam.CanCollide, beam.CanTouch, beam.CanQuery = false, false, false
    beam.Material = Enum.Material.Neon
    beam.Color = unit and Color3.fromRGB(unit.color[1], unit.color[2], unit.color[3]) or Color3.fromRGB(255, 100, 128)
    beam.Size = Vector3.new(0.18, 0.18, (target - origin).Magnitude)
    beam.CFrame = CFrame.lookAt((origin + target) / 2, target)
    beam.Parent = workspace
    TweenService:Create(beam, TweenInfo.new(0.16), {Transparency = 1}):Play()
    Debris:AddItem(beam, 0.2)
end)

RunService.RenderStepped:Connect(function()
    local camera = workspace.CurrentCamera
    if not camera then return end
    local view = camera.ViewportSize
    if view.Y &lt;= 0 then return end
    local scale = math.min(1, view.X / 740, view.Y / 630)
    headerScale.Scale, dockScale.Scale, noticeScale.Scale = scale, scale, scale
    controlsScale.Scale, detailScale.Scale = scale, scale
    controls.Position = UDim2.new(1, -12, 0, 20 + 82 * scale)
    detail.Position = UDim2.new(0, 12, 0, 20 + 82 * scale)
    notice.Position = UDim2.new(0.5, 0, 1, -20 - 132 * scale)
    -- A full-board tactical camera keeps the route visible on portrait screens too.
    camera.CameraType = Enum.CameraType.Scriptable
    camera.FieldOfView = 55
    local distance = math.max(135, 105 / (view.X / view.Y))
    local focus = Vector3.new(0, 0, 0)
    camera.CFrame = CFrame.lookAt(focus + Vector3.new(0, distance, distance * 0.72), focus)
    rangePart.Parent = nil
    local chosen = troopInfo(selectedTroop)
    local ownCount = 0
    if latest then for _, t in ipairs(latest.troops) do if t.owner == player.UserId then ownCount = ownCount + 1 end end end
    squadText.Text = "MY SQUAD  " .. ownCount .. " / " .. Config.MaxTroops
    if chosen then
        local model = troopsFolder:FindFirstChild("Troop_" .. chosen.id)
        local body = model and model:FindFirstChild("Body")
        local unit = Config.Units[chosen.kind]
        local stats = Config.stats(chosen.kind, chosen.level)
        if body and chosen.hp &gt; 0 then showRange(body.Position, stats.range, Color3.fromRGB(unit.color[1], unit.color[2], unit.color[3])) end
        detailTitle.Text = unit.name .. " / Lv." .. chosen.level
        detailBody.Text = string.format("HP  %d / %d    |    %s\nDAMAGE  %d     RANGE  %d\nATTACK  %.1fs     SPEED  %d\n%s\n\n%s", math.ceil(chosen.hp), chosen.maxHp, chosen.status, stats.damage, stats.range, stats.cooldown, stats.speed, unit.role, chosen.hp &lt;= 0 and "Returns from base next wave." or "Walks from our base. Fights on contact.")
        local owns = chosen.owner == player.UserId
        upgradeButton.Visible, sellButton.Visible = owns, owns
        upgradeButton.Text = stats.upgradeCost and ("UPGRADE  " .. stats.upgradeCost) or "MAX LEVEL"
        sellButton.Text = "SELL " .. math.floor(Config.invested(chosen.kind, chosen.level) * Config.SellRatio)
    else
        upgradeButton.Visible, sellButton.Visible = false, false
        detailTitle.Text = "YOUR MARCHING SQUAD"
        detailBody.Text = "1  Recruit with a card below\n2  Start the wave\n3  Your characters march out!\n\nBoth sides take damage.\nFallen allies return next wave.\n\nClick a fighter or use &lt; &gt; to manage your squad."
    end
    for kind, card in ipairs(cards) do
        card.stroke.Transparency = selectedKind == kind and 0 or 0.85
        card.price.TextColor3 = latest and latest.cash &lt; Config.Units[kind].cost and Color3.fromRGB(255, 145, 138) or Color3.new(1, 1, 1)
    end
    fxButton.Text = effects and "FX  ON" or "FX  OFF"
    if not latest then return end
    cashText.Text = latest.cash .. " CREDITS"
    waveText.Text = string.format("LANTERN VALLEY  /  WAVE %d OF %d", latest.wave, Config.MaxWaves)
    healthText.Text = string.format("SHRINE  %d / %d", latest.health, Config.BaseHealth)
    healthFill.Size = UDim2.fromScale(latest.health / Config.BaseHealth, 1)
    healthFill.BackgroundColor3 = latest.health &gt; 30 and accent or Color3.fromRGB(255, 110, 123)
    local count = 0
    for _, t in ipairs(latest.troops) do if t.owner == player.UserId then count = count + 1 end end
    capText.Text = count .. " / " .. Config.MaxTroops .. " UNITS"
    aliveText.Text = latest.allies .. " allies / " .. latest.alive .. " enemies"
    speedButton.Text = "SPEED  x" .. latest.speed
    local phase = latest.phase
    phaseText.Text = phase == "BUILD" and "ASSEMBLE YOUR SQUAD" or phase == "BREAK" and ("NEXT WAVE IN " .. latest.countdown .. "s") or phase == "VICTORY" and "VICTORY / SHRINE SAVED" or phase == "DEFEAT" and "DEFEAT / TRY A NEW PLAN" or "SQUAD IN BATTLE"
    startButton.Text = (phase == "VICTORY" or phase == "DEFEAT") and string.format("REPLAY VOTE  %d / %d", latest.votes, latest.players) or phase == "WAVE" and "WAVE IN PROGRESS" or phase == "BREAK" and "NEXT WAVE NOW" or "START WAVE  [SPACE]"
    startButton.BackgroundColor3 = phase == "WAVE" and muted or accent
end)
-- Connect listeners before requesting state so a fast server reply is not lost.
action:FireServer("Sync")
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="Lighting" referent="RBX9">
    <Properties>
      <string name="Name">Lighting</string>
    </Properties>
  </Item>
</roblox>